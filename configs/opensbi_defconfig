# OpenSBI configuration for the RISC-V emulator.
#
# The generic-platform FDT drivers present in linux-mmu.dts are enabled:
# the 16550 at 0x10000000, the CLINT timer/IPI at 0x02000000, the PLIC at
# 0x0c000000 and the syscon reset at 0x00100000.
#
# The SBI extensions used by the Linux image are enabled. The kernel is UP
# (CONFIG_SMP=n), uses the 16550 earlycon, and the DTS supplies
# syscon-reboot/syscon-poweroff. Both the minimal and maximal images use this
# feature set.

CONFIG_PLATFORM_GENERIC=y
CONFIG_FDT=y
CONFIG_FDT_DOMAIN=y
CONFIG_FDT_PMU=y
CONFIG_FDT_SERIAL=y
CONFIG_FDT_SERIAL_UART8250=y
CONFIG_FDT_TIMER=y
CONFIG_FDT_TIMER_MTIMER=y
CONFIG_FDT_IPI=y
CONFIG_FDT_IPI_MSWI=y
CONFIG_FDT_IRQCHIP=y
CONFIG_FDT_IRQCHIP_PLIC=y
CONFIG_FDT_RESET=y
CONFIG_FDT_RESET_SYSCON=y

CONFIG_SBI_ECALL_TIME=y
CONFIG_SBI_ECALL_IPI=y

# CONFIG_SBI_ECALL_RFENCE is not set
# CONFIG_SBI_ECALL_HSM is not set
# CONFIG_SBI_ECALL_SRST is not set
# CONFIG_SBI_ECALL_SUSP is not set
# CONFIG_SBI_ECALL_PMU is not set
# CONFIG_SBI_ECALL_DBCN is not set
# CONFIG_SBI_ECALL_CPPC is not set
# CONFIG_SBI_ECALL_FWFT is not set
# CONFIG_SBI_ECALL_LEGACY is not set
# CONFIG_SBI_ECALL_VENDOR is not set
# CONFIG_SBI_ECALL_DBTR is not set
# CONFIG_SBI_ECALL_SSE is not set
# CONFIG_SBI_ECALL_MPXY is not set
